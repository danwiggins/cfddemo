{
  "$defs": {
    "Depth": {
      "additionalProperties": false,
      "properties": {
        "approx_depth_x": {
          "minimum": 0,
          "title": "Approx Depth X",
          "type": "number"
        },
        "eligible_reads": {
          "minimum": 0,
          "title": "Eligible Reads",
          "type": "integer"
        },
        "index_mapped_upper_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Mapped Upper Bound"
        },
        "mean_span_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Span Bp"
        }
      },
      "required": [
        "eligible_reads",
        "approx_depth_x"
      ],
      "title": "Depth",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "description": "A failed result's scrubbed evidence (D20, D34).",
      "properties": {
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "first_line": {
          "maxLength": 300,
          "title": "First Line",
          "type": "string"
        },
        "stderr_tail": {
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Stderr Tail",
          "type": "array"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        }
      },
      "required": [
        "first_line",
        "stderr_tail"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci"
        },
        "ci_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Level"
        },
        "metric_id": {
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Metric Id",
          "type": "string"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "value"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "properties": {
        "data_ref": {
          "title": "Data Ref",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9-]{1,40}$",
          "title": "Kind",
          "type": "string"
        },
        "panel_id": {
          "pattern": "^[a-z0-9-]{1,64}$",
          "title": "Panel Id",
          "type": "string"
        }
      },
      "required": [
        "panel_id",
        "kind",
        "data_ref"
      ],
      "title": "Panel",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "The provenance stamp: who computed what from which input, when.",
      "properties": {
        "input_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Id",
          "type": "string"
        },
        "parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Reference Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        },
        "timestamp_utc": {
          "title": "Timestamp Utc",
          "type": "string"
        },
        "tool": {
          "pattern": "^[A-Za-z0-9_.:-]{1,120}$",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "pattern": "^[A-Za-z0-9_.+:-]{1,40}$",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "parameters_sha256",
        "source_id",
        "input_id",
        "reference_id",
        "timestamp_utc"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_id": {
      "pattern": "^[a-z0-9-]{1,40}$",
      "title": "Algorithm Id",
      "type": "string"
    },
    "algorithm_version": {
      "maxLength": 20,
      "minLength": 1,
      "title": "Algorithm Version",
      "type": "string"
    },
    "depth": {
      "anyOf": [
        {
          "$ref": "#/$defs/Depth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/Panel"
      },
      "title": "Panels",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema": {
      "const": "traceback.lab.result.v1",
      "default": "traceback.lab.result.v1",
      "title": "Schema",
      "type": "string"
    },
    "skip_message": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skip Message"
    },
    "skip_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skip Reason"
    },
    "status": {
      "enum": [
        "ok",
        "skipped",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "algorithm_id",
    "algorithm_version",
    "status",
    "provenance"
  ],
  "title": "ResultEnvelope",
  "type": "object"
}
